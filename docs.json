{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "icons": {
    "library": "lucide"
  },
  "name": "Cogfy Messenger",
  "colors": {
    "primary": "#42B62B",
    "light": "#369B22",
    "dark": "#3CDD5C"
  },
  "favicon": "/favicon.ico",
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "index",
              "quickstart"
            ]
          },
          {
            "group": "Fundamentals",
            "pages": [
              "guide/fundamentals/overview",
              "guide/fundamentals/members",
              "guide/fundamentals/tags",
              "guide/fundamentals/api-keys",
              "guide/fundamentals/contacts",
              "guide/fundamentals/analytics"
            ]
          },
          {
            "group": "Phone numbers",
            "pages": [
              "guide/phone-numbers/connect-phone-number",
              "guide/phone-numbers/phone-number-conversations",
              "guide/phone-numbers/whatsapp-phone-profile-settings"
            ]
          },
          {
            "group": "Workflows",
            "pages": [
              "guide/workflows/overview",
              "guide/workflows/tutorial-first-workflow",
              {
                "group": "Nodes",
                "expanded": true,
                "pages": [
                  {
                    "group": "Triggers",
                    "pages": [
                      "guide/workflows/nodes/triggers/message-received-node"
                    ]
                  },
                  {
                    "group": "Core",
                    "pages": [
                      "guide/workflows/nodes/core/java-script-code-node",
                      {
                        "group": "Assistant",
                        "pages": [
                          "guide/workflows/nodes/core/assistant/openai-assistant-node"
                        ]
                      },
                      {
                        "group": "Send Message",
                        "pages": [
                          "guide/workflows/nodes/core/send-message/send-whatsapp-text-message"
                        ]
                      }
                    ]
                  },
                  {
                    "group": "Logic",
                    "pages": [
                      "guide/workflows/nodes/logic/if-node"
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "openapi": "openapi.json",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "api-reference/introduction",
              "api-reference/authentication"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Cogfy Messenger",
          "href": "https://messenger.cogfy.com",
          "icon": "link"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/Dark.svg",
    "dark": "/logo/Light.svg"
  },
  "navbar": {},
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/mintlify",
      "github": "https://github.com/mintlify",
      "linkedin": "https://linkedin.com/company/mintlify"
    }
  }
}
